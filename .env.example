# Required: your Anthropic API key for Claude Haiku email classification
ANTHROPIC_API_KEY=sk-ant-...

# Optional: path to your Google OAuth2 credentials file (default: credentials/credentials.json)
# GOOGLE_CREDENTIALS_FILE=credentials/credentials.json

# Optional: path to the OAuth token file (default: credentials/token.json)
# GOOGLE_TOKEN_FILE=credentials/token.json

# Optional: SQLite database path (default: jobhunter.db)
# DATABASE_PATH=jobhunter.db
